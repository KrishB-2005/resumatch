# ResuMatch runs fully offline by default. Nothing here is required.
#
# The deterministic matcher — the part that produces the score — never calls a
# model and never needs a key. These only affect `--semantic`, which asks a
# model about the requirements that name no skill.

# Set at most one. Whichever is present decides the provider.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Override the provider explicitly: openai, anthropic, or fixture.
# fixture is the keyless default and declines every judgement, which keeps the
# deterministic score honest rather than padding it with stub answers.
# RESUMATCH_PROVIDER=fixture

# Override the model. Defaults: gpt-4o / claude-sonnet-5.
# RESUMATCH_MODEL=
